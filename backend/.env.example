# Copy this file to .env and fill in your key.

# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Model used for claim classification. gemini-2.0-flash is fast and cheap;
# swap for whatever model your API key has access to.
GEMINI_MODEL=gemini-3.5-flash-lite

# Per-call timeout / a small delay between calls to stay under free-tier rate limits.
GEMINI_TIMEOUT_SECONDS=20
GEMINI_SLEEP_SECONDS=0.5

# Comma-separated list of origins allowed to call this API (your Next.js dev server).
ALLOWED_ORIGINS=http://localhost:3000

# Set to false to disable API key auth entirely (e.g. quick local testing).
REQUIRE_API_KEY=true

# How many verification records to keep in the analytics history log.
HISTORY_MAX_ITEMS=500
